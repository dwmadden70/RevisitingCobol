>>SOURCE FORMAT IS FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. SUMCSV.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CSV-FILE ASSIGN TO "input.txt"
    ORGANIZATION IS LINE SEQUENTIAL
    FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD  CSV-FILE.
01  CSV-RECORD           PIC X(100).

WORKING-STORAGE SECTION.
01  WS-FLAGS.
    05 WS-EOF-FLAG       PIC X(01) VALUE 'N'.
01  WS-STATUS-CODES.
    05 WS-FILE-STATUS    PIC X(02).

01  WS-COUNTERS.
    05 WS-LINE-NUM       PIC 9(04) VALUE 0.
    05 WS-IDX            PIC 9(03) VALUE 1.
    05 WS-CHAR-COUNT     PIC 9(03) VALUE 0.

01  WS-ACCUMULATORS.
    05 WS-LINE-SUM       PIC S9(9)V99 VALUE 0.
    05 WS-NUM-VAL        PIC S9(9)V99 VALUE 0.

01  WS-PARSING.
    05 WS-TEMP-STR       PIC X(20) VALUE SPACES.
    05 WS-TEMP-IDX       PIC 9(02) VALUE 1.

01  WS-OUTPUT-LINE.
    05 FILLER            PIC X(06) VALUE "Line ".
    05 DET-LINE-NUM      PIC ZZZ9.
    05 FILLER            PIC X(07) VALUE " Sum: ".
    05 DET-LINE-SUM      PIC ---,---,---.99.

PROCEDURE DIVISION.
0000-MAIN.
    DISPLAY "--- EXECUTION STARTED ---"

    OPEN INPUT CSV-FILE
    DISPLAY "DEBUG: File Status after open attempt is: " WS-FILE-STATUS

    IF WS-FILE-STATUS = "35"
        DISPLAY "CRITICAL: 'input.txt' was not found in this folder!"
        CLOSE CSV-FILE
        STOP RUN
    END-IF

    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "CRITICAL: File error code: " WS-FILE-STATUS
        CLOSE CSV-FILE
        STOP RUN
    END-IF

    PERFORM UNTIL WS-EOF-FLAG = 'Y'
        READ CSV-FILE
            AT END
                DISPLAY "DEBUG: Reached End of File successfully."
                SET WS-EOF-FLAG TO 'Y'
            NOT AT END
                ADD 1 TO WS-LINE-NUM
                PERFORM 1000-PROCESS-LINE
        END-READ
    END-PERFORM

    CLOSE CSV-FILE
    DISPLAY "--- EXECUTION FINISHED ---"
    STOP RUN.

1000-PROCESS-LINE.
    MOVE 0 TO WS-LINE-SUM
    MOVE 1 TO WS-IDX
    MOVE 1 TO WS-TEMP-IDX
    MOVE SPACES TO WS-TEMP-STR

    MOVE FUNCTION STORED-CHAR-LENGTH(CSV-RECORD) TO WS-CHAR-COUNT

    IF WS-CHAR-COUNT = 0
        DISPLAY "DEBUG: Found an empty row at line " WS-LINE-NUM
    END-IF

    PERFORM UNTIL WS-IDX > WS-CHAR-COUNT
        IF CSV-RECORD(WS-IDX:1) = ','
            PERFORM 2000-ADD-TEMP-NUM
        ELSE
            IF CSV-RECORD(WS-IDX:1) NOT = SPACE
                MOVE CSV-RECORD(WS-IDX:1) TO WS-TEMP-STR(WS-TEMP-IDX:1)
                ADD 1 TO WS-TEMP-IDX
            END-IF
        END-IF
        ADD 1 TO WS-IDX
    END-PERFORM

    PERFORM 2000-ADD-TEMP-NUM

    MOVE WS-LINE-NUM TO DET-LINE-NUM
    MOVE WS-LINE-SUM TO DET-LINE-SUM
    DISPLAY WS-OUTPUT-LINE.

2000-ADD-TEMP-NUM.
    IF WS-TEMP-STR NOT = SPACES
        COMPUTE WS-NUM-VAL = FUNCTION NUMVAL(WS-TEMP-STR)
        ADD WS-NUM-VAL TO WS-LINE-SUM
        MOVE SPACES TO WS-TEMP-STR
        MOVE 1 TO WS-TEMP-IDX
    END-IF.
