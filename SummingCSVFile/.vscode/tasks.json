{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run COBOL",
            "type": "shell",
            "command": "cd '${fileDirname}'; cobc -x -o .\\${fileBasenameNoExtension}.exe .\\${fileBasename}; if ($?) { Start-Sleep -Milliseconds 100; .\\${fileBasenameNoExtension}.exe }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
