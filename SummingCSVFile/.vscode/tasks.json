{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run COBOL",
            "type": "shell",
            "command": "cobc -x -o sumcsv.exe sumcsv.cob ; if ($?) { Start-Sleep -Milliseconds 100; .\\sumcsv.exe }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "clear": true
            }
        }
    ]
}
